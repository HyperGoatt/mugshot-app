<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mugshot</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>co.mugshot.app.routes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mugshot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>facebook-stories</string>
		<string>snapchat</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MUGSHOT_APP_STORE_URL</key>
	<string>$(MUGSHOT_APP_STORE_URL)</string>
	<key>MUGSHOT_META_APP_ID</key>
	<string>$(MUGSHOT_META_APP_ID)</string>
	<key>MUGSHOT_POSTHOG_HOST</key>
	<string>$(MUGSHOT_POSTHOG_HOST)</string>
	<key>MUGSHOT_POSTHOG_PROJECT_TOKEN</key>
	<string>$(MUGSHOT_POSTHOG_PROJECT_TOKEN)</string>
	<key>MUGSHOT_PUBLIC_BASE_URL</key>
	<string>$(MUGSHOT_PUBLIC_BASE_URL)</string>
	<key>MUGSHOT_SNAPCHAT_CLIENT_ID</key>
	<string>$(MUGSHOT_SNAPCHAT_CLIENT_ID)</string>
	<key>MUGSHOT_SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(MUGSHOT_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>MUGSHOT_SUPABASE_URL</key>
	<string>$(MUGSHOT_SUPABASE_URL)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mugshot uses your location to show cafes near you on the map and help you discover new places.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mugshot lets you choose photos from your library to attach to coffee visits.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Mugshot saves the Story or Post image you choose from the Share Hub.</string>
	<key>NSCameraUsageDescription</key>
	<string>Mugshot uses your camera so you can capture a coffee visit as it happens.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
